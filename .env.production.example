# Copy to backend/.env on the server and fill in the blanks. This is loaded
# via docker-compose's env_file, INTO the backend container — MONGO_URI must
# use the Docker service name ("mongo"), not localhost.

NODE_ENV=production
PORT=4000

MONGO_URI=mongodb://mongo:27017/cloud_workspace

# The real frontend origin — must be exact (no trailing slash), the browser sends it as Origin.
CORS_ORIGIN=https://workspace.keyset.in

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# 32-byte hex key for AES-256-GCM encryption of workspace environment values
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENV_ENCRYPTION_KEY=

BASE_WORKSPACE_DOMAIN=workspace.keyset.in

# nginx terminates TLS in front of Traefik, so workspace URLs are https and
# use the standard port (no WORKSPACE_PROXY_PORT — that's local-dev only).
WORKSPACE_PROTOCOL=https

# Comma-separated. Any account with a matching email is auto-promoted to
# admin on register or login — set this to your own email to bootstrap.
ADMIN_EMAILS=
