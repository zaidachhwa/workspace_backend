NODE_ENV=development
PORT=4000

MONGO_URI=mongodb://localhost:27017/cloud_workspace

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# 32-byte hex key for AES-256-GCM encryption of workspace environment values
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENV_ENCRYPTION_KEY=

BASE_WORKSPACE_DOMAIN=workspaces.example.com

# Local dev only: localtest.me resolves any subdomain to 127.0.0.1, and the
# proxy binds a non-standard port here since :80 is often already taken.
# In production, leave both unset — Traefik binds :80/:443 on the real domain.
# BASE_WORKSPACE_DOMAIN=localtest.me
# WORKSPACE_PROXY_PORT=8090
